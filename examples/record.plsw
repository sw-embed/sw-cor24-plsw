/* record.plsw -- Record and Pointer Demo for PL/SW
 * Declares a multi-level record, fills fields, takes address,
 * accesses fields via pointer dereference.
 * Demonstrates: level-based DCL, record field access, ADDR(),
 * pointer dereference (P->field), arithmetic on fields. */

/* Pre-declared label strings. Inline string literals to ADDR()
 * are not supported by the current codegen ("ADDR requires a
 * variable, field, or array element"), so each label is a
 * named CHAR array. Trailing space separates label from value;
 * NUL-terminated so PRINT_STR knows where to stop. */
DCL LBL_X    (8) CHAR INIT('X = ');
DCL LBL_Y    (8) CHAR INIT('Y = ');
DCL LBL_PX   (8) CHAR INIT('P->X = ');
DCL LBL_PY   (8) CHAR INIT('P->Y = ');
DCL LBL_SUM  (8) CHAR INIT('Sum = ');

DCL DIGITS(12) CHAR;

/* BASED template + ptr for byte-by-byte string traversal.
 * PL/SW PROC parameters can't subscript a PTR directly, so we
 * route each access through a BASED single-byte record and
 * advance the global PTR by one byte per iteration. */
DCL 1 STR_REC BASED,
    3 B BYTE;
DCL STR_PTR PTR;

/* Print a NUL-terminated CHAR buffer to UART byte by byte.
 * Unlike UART_PUTS (which appends a newline after the string),
 * PRINT_STR emits exactly the bytes between the start address
 * and the first NUL, so a label and a number can share a line. */
PRINT_STR: PROC(S PTR);
    DCL C BYTE;

    STR_PTR = S;
    DO WHILE (1);
        C = STR_PTR->B;
        IF (C = 0) THEN RETURN;
        CALL UART_PUTCHAR(C);
        STR_PTR = STR_PTR + 1;
    END;
END;

/* Print a non-negative integer to UART as decimal digits. */
PRINT_INT: PROC(N INT);
    DCL D INT;
    DCL POS INT;

    IF (N = 0) THEN DO;
        CALL UART_PUTCHAR(48);
        RETURN;
    END;

    POS = 0;
    DO WHILE (N > 0);
        D = N / 10;
        DIGITS(POS) = N - D * 10 + 48;
        N = D;
        POS = POS + 1;
    END;

    DO WHILE (POS > 0);
        POS = POS - 1;
        CALL UART_PUTCHAR(DIGITS(POS));
    END;
END;

/* Main: record and pointer operations */
MAIN: PROC;
    DCL 1 POINT,
        3 X INT,
        3 Y INT;
    DCL P PTR;

    /* Fill record fields directly */
    POINT.X = 100;
    POINT.Y = 200;

    /* Print field values: each row is "label value\n" */
    CALL PRINT_STR(ADDR(LBL_X));
    CALL PRINT_INT(POINT.X);
    CALL UART_PUTCHAR(10);

    CALL PRINT_STR(ADDR(LBL_Y));
    CALL PRINT_INT(POINT.Y);
    CALL UART_PUTCHAR(10);

    /* Take address, access via pointer */
    P = ADDR(POINT);

    CALL PRINT_STR(ADDR(LBL_PX));
    CALL PRINT_INT(P->X);
    CALL UART_PUTCHAR(10);

    CALL PRINT_STR(ADDR(LBL_PY));
    CALL PRINT_INT(P->Y);
    CALL UART_PUTCHAR(10);

    /* Compute sum via pointer */
    CALL PRINT_STR(ADDR(LBL_SUM));
    CALL PRINT_INT(P->X + P->Y);
    CALL UART_PUTCHAR(10);
END;
