/* --- Helper PROCs (never called; DCE'd at link time) --- */
P000: PROC(A INT, B INT) RETURNS(INT);
    DCL X INT;
    DCL Y INT;
    DCL Z INT;
    X = A + B;
    Y = A - B;
    X = Y + Z + 1;
    Y = Z - X + 2;
    Z = X * Y + 3;
    X = Y + Z + 4;
    Y = Z - X + 5;
    Z = X * Y + 6;
    X = Y + Z + 7;
    Y = Z - X + 1;
    Z = X * Y + 2;
    X = Y + Z + 3;
