    Z = X * Y + 4;
    X = Y + Z + 5;
    Y = Z - X + 6;
    Z = X * Y + 7;
    X = Y + Z + 1;
    Y = Z - X + 2;
    Z = X * Y + 3;
    X = Y + Z + 4;
    Z = X + Y;
    RETURN(Z);
END;

